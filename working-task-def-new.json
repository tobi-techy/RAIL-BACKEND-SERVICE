{
  "containerDefinitions": [
    {
      "name": "rail-backend",
      "image": "885160773772.dkr.ecr.us-east-1.amazonaws.com/rail-backend:chainrails-test",
      "cpu": 0,
      "memory": 450,
      "portMappings": [
        {
          "containerPort": 8080,
          "hostPort": 0,
          "protocol": "tcp"
        }
      ],
      "essential": true,
      "environment": [
        {
          "name": "REDIS_HOST",
          "value": "rail-prod.q0riyh.0001.use1.cache.amazonaws.com"
        },
        {
          "name": "PORT",
          "value": "8080"
        },
        {
          "name": "REDIS_PORT",
          "value": "6379"
        },
        {
          "name": "OTEL_SDK_DISABLED",
          "value": "true"
        },
        {
          "name": "GIN_MODE",
          "value": "release"
        },
        {
          "name": "ENVIRONMENT",
          "value": "prod"
        }
      ],
      "mountPoints": [],
      "volumesFrom": [],
