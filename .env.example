# ============================================
# RAIL Backend Service - Environment Variables
# ============================================
# Copy this file to .env and fill in your actual values
# DO NOT commit .env to version control!

# ============================================
# Application Configuration
# ============================================
ENVIRONMENT=development
PORT=8080
BASE_URL=http://localhost:8080

# ============================================
# Database Configuration
# ============================================
# For development, SSL can be disabled
DATABASE_URL=postgres://postgres:postgres@localhost:5432/rail_service_dev?sslmode=disable

# For production, use a secure connection with SSL required:
# DATABASE_URL=postgres://username:password@host:5432/rail_service_prod?sslmode=require
# SSL modes: disable, allow, prefer, require, verify-ca, verify-full
# Production should use 'require' at minimum, 'verify-full' for highest security
DATABASE_SSL_MODE=${DATABASE_SSL_MODE:-disable}

# ============================================
# Redis Configuration
# ============================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ============================================
# Rate Limiting Configuration
# ============================================
# Enable/disable distributed rate limiting
RATE_LIMIT_ENABLED=true
# Global rate limit (requests per window across all instances)
RATE_LIMIT_GLOBAL_LIMIT=10000
RATE_LIMIT_GLOBAL_WINDOW=60
# Per-IP rate limit
RATE_LIMIT_IP_LIMIT=500
RATE_LIMIT_IP_WINDOW=60
# Per-user rate limit (authenticated requests)
RATE_LIMIT_USER_LIMIT=200
RATE_LIMIT_USER_WINDOW=60
# Fail open if Redis is unavailable (set to false in production)
RATE_LIMIT_FAIL_OPEN=true
# Include rate limit headers in responses
RATE_LIMIT_RESPONSE_HEADERS=true

# Background workers
# Set false when Cloudflare Cron owns Miriam intelligence scheduling.
WORKERS_MIRIAM_INTELLIGENCE_LOCAL=true
WORKERS_MIRIAM_INTELLIGENCE_BATCH_SIZE=500

# ============================================
# Security & Authentication
# ============================================
# JWT Secret - MUST be changed in production (min 32 characters, generate with: openssl rand -base64 32)
JWT_SECRET=your-super-secret-jwt-key-change-in-production-min-32-chars
# Auth/session lifetimes (seconds)
ACCESS_TOKEN_TTL=3600      # 1 hour
REFRESH_TOKEN_TTL=2592000  # 30 days

# Encryption Key - MUST be exactly 32 bytes for AES-256 (generate with: openssl rand -base64 32)
ENCRYPTION_KEY=your-32-byte-encryption-key-!!

# Password Policy (ENFORCE these in production)
# Minimum password length: 12 characters (changed from 8)
PASSWORD_MIN_LENGTH=12
# Require uppercase letters
PASSWORD_REQUIRE_UPPERCASE=true
# Require lowercase letters
PASSWORD_REQUIRE_LOWERCASE=true
# Require numbers
PASSWORD_REQUIRE_NUMBERS=true
# Require special characters
PASSWORD_REQUIRE_SPECIAL=true
# Password expiration in days (90 days recommended)
PASSWORD_EXPIRATION_DAYS=90
# Prevent reuse of last N passwords
PASSWORD_HISTORY_COUNT=5

# ============================================
# Circle Programmable Wallets (Primary Wallet/Custody Provider)
# ============================================
CIRCLE_API_KEY=your-circle-api-key
CIRCLE_BASE_URL=https://api.circle.com
CIRCLE_ENVIRONMENT=sandbox
# Options: sandbox, production

# Circle Entity Secret - 64-char hex string (32 bytes). Generate once, store securely.
# Used to sign all developer-controlled wallet operations.
CIRCLE_ENTITY_SECRET=your-64-char-hex-entity-secret

# Circle Entity Secret Ciphertext - registered once via Circle Dashboard
CIRCLE_ENTITY_SECRET_CIPHERTEXT=your-registered-ciphertext

# Circle Public Key PEM - RSA public key for encrypting the entity secret per request
# Obtain from GET /v1/w3s/config/entity/publicKey or Circle Dashboard
EXPO_PUBLIC_CIRCLE_PUBLIC_KEY_PEM="-----BEGIN PUBLIC KEY-----
MIICIjANBgkqhkiG9w0BAQEFAAOCAg8AMIICCgKCAgEAxQsczKCXuMCgyGYff2tZ
...
-----END PUBLIC KEY-----"

# Circle Wallet Configuration
CIRCLE_DEFAULT_WALLET_SET_ID=your-wallet-set-id
CIRCLE_DEFAULT_WALLET_SET_NAME=rail-wallets
CIRCLE_WEBHOOK_SECRET=your-circle-webhook-secret

# Supported blockchain chains (comma-separated)
CIRCLE_SUPPORTED_CHAINS=SOL,ETH,MATIC,BASE,ARB,AVAX,OP

# ============================================
# Email Service Configuration
# ============================================
EMAIL_PROVIDER=unosend

# Unosend Configuration
# API Key format: un_xxxxxxxxxx (required)
UNOSEND_API_KEY=un_your_api_key
EMAIL_FROM_EMAIL=noreply@yourdomain.com
EMAIL_FROM_NAME=RAIL
EMAIL_REPLY_TO=support@yourdomain.com

# Admin error alert email — detailed error reports sent here on critical failures
# (panics, transfer failures, ledger inconsistencies). Leave empty to disable.
ADMIN_ALERT_EMAIL=ops@yourdomain.com

# ============================================
# Alpaca Brokerage Integration
# ============================================
ALPACA_API_KEY=your-alpaca-api-key
ALPACA_API_SECRET=your-alpaca-api-secret
ALPACA_ENVIRONMENT=paper
# Options: paper, live

# Alpaca API Endpoints
ALPACA_BASE_URL=https://paper-api.alpaca.markets
# For production: https://api.alpaca.markets

ALPACA_DATA_BASE_URL=https://data.alpaca.markets
# Same for both paper and live trading
ALPACA_DATA_API_KEY=
ALPACA_DATA_API_SECRET=
# Optional: dedicated market-data credentials. Falls back to ALPACA_API_KEY/ALPACA_API_SECRET if unset.
ALPACA_DATA_FEED=iex
# Recommended for starter plans: iex. Other options include sip and otc.

# Alpaca Webhook Secret (for webhook signature verification)
ALPACA_WEBHOOK_SECRET=
# Generate with: openssl rand -base64 32

# Market explorer logos (Logo.dev ticker logos)
MARKET_LOGO_PROVIDER=logo_dev
MARKET_LOGO_BASE_URL=https://img.logo.dev
LOGO_DEV_PUBLISHABLE_KEY=
LOGO_DEV_SIZE=128
LOGO_DEV_FORMAT=png
LOGO_DEV_THEME=auto

# ============================================
# Due Integration (Treasury/Banking)
# ============================================
DUE_API_KEY=your-due-api-key
DUE_ACCOUNT_ID=your-due-account-id
DUE_BASE_URL=https://api.due.com

# ============================================
# Bridge API Configuration (Alternative to Circle)
# ============================================
BRIDGE_API_KEY=your-bridge-api-key
BRIDGE_BASE_URL=https://api.bridge.xyz
BRIDGE_ENVIRONMENT=sandbox
BRIDGE_TIMEOUT=30
BRIDGE_MAX_RETRIES=3
BRIDGE_SUPPORTED_CHAINS=ETH,MATIC,AVAX,SOL
# Required in production: HMAC secret used to verify inbound Bridge webhooks.
BRIDGE_WEBHOOK_SECRET=your-bridge-webhook-secret
# Rail's own Bridge customer/treasury identifiers (used for reconciliation and sweeps).
BRIDGE_RAIL_CUSTOMER_ID=
BRIDGE_TREASURY_WALLET_ADDRESS=

# ============================================
# Reflect Money Yield Configuration
# ============================================
# REFLECT_API_KEY is optional for public endpoints; only set it for whitelisted endpoints.
REFLECT_API_KEY=
REFLECT_BASE_URL=https://prod.api.reflect.money
REFLECT_SOLANA_RPC=https://api.mainnet-beta.solana.com
# User Circle wallet mint/burn routing is primary; treasury owner/private key are only for legacy treasury sweep.
REFLECT_OWNER_WALLET=
REFLECT_PRIVATE_KEY=
REFLECT_STABLECOIN_INDEX=0
REFLECT_ENABLE_TREASURY_SWEEP=false
# Only used when REFLECT_ENABLE_TREASURY_SWEEP=true.
REFLECT_MIN_SWEEP_AMOUNT=1
# Only used when REFLECT_ENABLE_TREASURY_SWEEP=true.
REFLECT_CIRCLE_SOURCE_WALLET_ID=
# Legacy Bridge fallback.
REFLECT_BRIDGE_SOURCE_WALLET_ID=
# Comma-separated Reflect protocol program IDs Circle may sign for user-wallet mint/burn transactions.
# Default Solana system/token/ATA/compute/memo programs are allowed in code.
# SECURITY: only use program IDs from official Reflect documentation/support. Wrong IDs may block legitimate transactions or permit unsafe signing.
# Source: @reflectmoney/stable.ts v4.0.2 REFLECT_MAIN_PROGRAM_ADDRESS.
REFLECT_ALLOWED_PROGRAM_IDS=rFLctqnUuxLmYsW5r9zNujfJx9hGpnP1csXr9PYwVgX

# ============================================
# 0G Storage & Compute (AI/ML Infrastructure)
# ============================================
# 0G Storage Configuration
ZEROG_STORAGE_RPC_ENDPOINT=https://rpc-storage.0g.ai
ZEROG_STORAGE_INDEXER_RPC=https://indexer.0g.ai
ZEROG_STORAGE_PRIVATE_KEY=your-0g-storage-private-key

# 0G Compute Configuration
ZEROG_COMPUTE_BROKER_ENDPOINT=https://broker.0g.ai
ZEROG_COMPUTE_PRIVATE_KEY=your-0g-compute-private-key
ZEROG_COMPUTE_PROVIDER_ID=your-provider-id

# ============================================
# Monitoring & Observability
# ============================================
# Sentry (Error Tracking)
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
SENTRY_ENVIRONMENT=development

# OpenTelemetry (Tracing)
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=rail-service

# ============================================
# Miriam AI (voice, canvas, web search, observability)
# Set these as secrets in AtlasFlow for any environment that runs Miriam.
# ============================================
# Tavily — powers web_search (places / flights / recommendations).
# Without it, web_search fails safe ("web search not available").
TAVILY_API_KEY=
# ElevenLabs voice agent. WEBHOOK_SECRET must equal the value behind the
# ElevenLabs server-tool secret, or voice_money_lookup calls return 401.
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
ELEVENLABS_SUPPORT_AGENT_ID=
ELEVENLABS_WEBHOOK_SECRET=
# Optional voice overrides
# ELEVENLABS_VOICE_ID=
# ELEVENLABS_PIDGIN_VOICE_ID=
# Max money moved via voice per day (USD). Default 500 if unset.
VOICE_DAILY_LIMIT_USD=500
# Langfuse LLM observability (OTLP/HTTP). Leave blank to disable.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
# Send prompt/response TEXT to Langfuse. KEEP false in prod (financial PII).
LANGFUSE_CAPTURE_CONTENT=false

# Prometheus Metrics
METRICS_ENABLED=true
METRICS_PORT=9090

# ============================================
# Feature Flags
# ============================================
ENABLE_RECONCILIATION=false
ENABLE_AI_CFO=false
ENABLE_COPY_TRADING=false
ENABLE_DEBIT_CARDS=false

# ============================================
# Rate Limiting
# ============================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=100
RATE_LIMIT_BURST=20

# ============================================
# CORS Configuration
# ============================================
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Content-Type,Authorization

# ============================================
# Logging Configuration
# ============================================
LOG_LEVEL=info
# Options: debug, info, warn, error

LOG_FORMAT=json
# Options: json, console

# ============================================
# Worker Configuration
# ============================================
# Wallet Provisioning
WALLET_PROVISIONING_ENABLED=true
WALLET_PROVISIONING_POLL_INTERVAL=30s
WALLET_PROVISIONING_MAX_CONCURRENCY=5
WALLET_PROVISIONING_BATCH_SIZE=10

# Funding Webhook Workers
FUNDING_WEBHOOK_WORKERS=5
FUNDING_WEBHOOK_RECONCILIATION_INTERVAL=10m
FUNDING_WEBHOOK_RECONCILIATION_THRESHOLD=15m
FUNDING_WEBHOOK_RECONCILIATION_BATCH_SIZE=50

# ============================================
# Timeouts & Limits
# ============================================
HTTP_READ_TIMEOUT=30s
HTTP_WRITE_TIMEOUT=30s
HTTP_IDLE_TIMEOUT=120s

DB_MAX_OPEN_CONNECTIONS=25
DB_MAX_IDLE_CONNECTIONS=5
DB_CONNECTION_MAX_LIFETIME=5m

# ============================================
# Development/Testing Only
# ============================================
# Set to true to enable debug features (DO NOT use in production)
DEBUG_MODE=false
ENABLE_SWAGGER=true
ENABLE_PPROF=false

# Mock external services for testing
MOCK_CIRCLE_API=false  # Legacy
MOCK_ALPACA_API=false
MOCK_KYC_PROVIDER=false

# ============================================
# Paj Cash NGN On/Off Ramp
# ============================================
PAJ_API_KEY=your-paj-api-key
PAJ_BASE_URL=https://api.paj.cash
PAJ_WALLET_ADDRESS=your-usdc-custody-wallet-address
PAJ_TOKEN_MINT=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v
PAJ_CHAIN=SOLANA

# ============================================
# RampHub On/Off Ramp Aggregator (best-rate routing)
# ============================================
# SECURITY: treat as a secret — never commit the real value; rotate immediately if leaked
RAMPHUB_API_KEY=your-ramphub-api-key
RAMPHUB_BASE_URL=https://api.ramphub.io
# SECURITY: HMAC-SHA256 signing secret for inbound webhooks — must match what is registered in the RampHub dashboard
RAMPHUB_WEBHOOK_SECRET=your-ramphub-webhook-signing-secret
RAMPHUB_WEBHOOK_URL=https://api.userail.money/api/v1/webhooks/ramphub
# Webhook route mount point — change to separate sandbox/prod endpoints (e.g. "/ramphub-prod")
RAMPHUB_WEBHOOK_PATH=/ramphub
# Rail's business fee % applied to every RampHub order (e.g. 0.5 for 0.5%)
RAMPHUB_DEVELOPER_FEE_PERCENT=0.5
# Set to "true" when using test/sandbox API keys so sandbox webhooks (livemode:false) are processed.
# Must be "false" in production with live API keys. Omit to default to false.
# RAMPHUB_SANDBOX=false

# ============================================
# Graph (useoval.com) — NGN named virtual bank accounts
# Named Naira accounts; NGN deposits auto-convert to USDC and run the 70/30 split.
# ============================================
GRAPH_ENABLED=false
# SECURITY: treat as a secret — never commit the real value; rotate immediately if leaked
GRAPH_API_KEY=your-graph-api-key
GRAPH_BASE_URL=https://api.useoval.com
# SECURITY: HMAC-SHA256 signing secret for inbound webhooks
# Generate with: openssl rand -hex 32
# Set this same value as the webhook secret in your Graph dashboard
GRAPH_WEBHOOK_SECRET=your-graph-webhook-signing-secret
# Webhook route mount point — change to separate sandbox/prod endpoints (e.g. "/graph-prod")
GRAPH_WEBHOOK_PATH=/graph
# Rail's business fee % applied to every NGN deposit (e.g. 0.5 for 0.5%)
GRAPH_DEVELOPER_FEE_PERCENT=0.5

# ============================================
# Didit KYC / Liveness (identity spine for Tier 2 liveness + Tier 3 Bridge KYC)
# Set KYC_PROVIDER=didit to activate; without these the Didit client AND the
# compliance/AML screening pipeline stay DISABLED (silently).
# ============================================
KYC_PROVIDER=didit
# SECURITY: treat as secrets — never commit real values; rotate immediately if leaked
DIDIT_API_KEY=your-didit-api-key
DIDIT_WEBHOOK_SECRET=your-didit-webhook-secret
DIDIT_WORKFLOW_ID=your-didit-workflow-id

# ============================================
# Cloudflare R2 Storage (KYC documents, statements, uploads)
# Consumed via viper AutomaticEnv (cloudflare.* ← CLOUDFLARE_*).
# ============================================
CLOUDFLARE_ACCOUNT_ID=
# SECURITY: treat as secrets — never commit real values; rotate immediately if leaked
CLOUDFLARE_ACCESS_KEY=
CLOUDFLARE_SECRET_KEY=
CLOUDFLARE_R2_BUCKET=
CLOUDFLARE_R2_PUBLIC_URL=
CLOUDFLARE_WORKER_URL=

# Document Intelligence Pipeline (PaddleOCR sidecar + R2)
# Consumed via explicit viper BindEnv (document.* ← DOCUMENT_*).
DOCUMENT_OCR_SERVICE_URL=
DOCUMENT_ENABLE_PYTHON_OCR=false
DOCUMENT_MIN_OCR_CONFIDENCE=0.5

# ============================================
# Airbills Bill Payments (airtime, data, electricity, cable TV, betting, transport)
# Settles in USDC/USDT on Solana. Powers Miriam bill pay.
# ============================================
# SECURITY: business secret key sent in the `secretkey` header — never commit the real value; rotate immediately if leaked
AIRBILLS_SECRET_KEY=your-airbills-secret-key
AIRBILLS_BASE_URL=https://developer.airbills.org/api/vendor/gateway
# Rail endpoint Airbills POSTs fulfillment callbacks to
AIRBILLS_CALLBACK_URL=https://api.userail.money/api/v1/webhooks/airbills
# SECURITY: HMAC-SHA256 signing secret for inbound callbacks
AIRBILLS_WEBHOOK_SECRET=your-airbills-webhook-signing-secret
# Webhook route mount point (defaults to "/airbills")
AIRBILLS_WEBHOOK_PATH=/airbills
# Rail's service fee % added to each bill (e.g. 1.0 for 1%)
AIRBILLS_DEVELOPER_FEE_PERCENT=1.0
# Settlement token: USDC or USDT (defaults to USDC)
AIRBILLS_DEFAULT_TOKEN=USDC
# Hard per-payment ceiling in NGN (safety cap)
AIRBILLS_MAX_AMOUNT_NGN=100000

# ============================================
# Travu Bus & Flight Booking (interstate bus + domestic/international flights)
# Bookings debit Rail's prefunded NGN float on the Travu dashboard; Rail charges
# the user in USDC via a ledger hold at the live FX rate. Powers Miriam travel.
# ============================================
# SECURITY: Bearer token sent in the Authorization header — never commit the real value; rotate immediately if leaked
TRAVU_SECRET_KEY=your-travu-bearer-token
TRAVU_BASE_URL=https://api.travu.africa/api/v1
# When true, use Travu's /test base URL for demo inventory
TRAVU_SANDBOX=false
# Rail's Travu account email, sent on bus bookings
TRAVU_AGENT_EMAIL=ops@userail.money
# Gate flight search until Travu enables the endpoint (currently "coming soon")
TRAVU_FLIGHT_SEARCH_ENABLED=false
# Rail's service fee % added to each booking (e.g. 2.0 for 2%)
TRAVU_DEVELOPER_FEE_PERCENT=2.0
# Hard per-booking ceiling in NGN (safety cap)
TRAVU_MAX_AMOUNT_NGN=2000000

# ============================================
# Analytics (Mixpanel + PostHog)
# ============================================
MIXPANEL_TOKEN=your-mixpanel-project-token
# PostHog — server-side event tracking, feature flags, session replay correlation
# Get your key from Project Settings → API Keys
POSTHOG_API_KEY=your-posthog-project-api-key
# US cloud: https://us.i.posthog.com  |  EU cloud: https://eu.i.posthog.com  |  Self-hosted: your URL
POSTHOG_HOST=https://us.i.posthog.com

# ============================================
# Qdrant Vector Store (episodic + fact memory)
# When configured, augments Supermemory with self-hosted vector search.
# ============================================
AI_QDRANT_BASE_URL=
AI_QDRANT_API_KEY=
AI_QDRANT_DEFAULT_DIM=768
AI_QDRANT_COLLECTION_PREFIX=rail

# Cencori AI gateway (OpenAI-compatible proxy with built-in failover, PII detection,
# prompt injection protection, and end-user billing).
CENCORI_API_KEY=
CENCORI_MODEL=gpt-4o

# ============================================
# Platform Messaging (iMessage / WhatsApp / Telegram)
# ============================================
PLATFORM_ENABLED=false
PLATFORM_AMQP_URL=amqps://user:pass@host.cloudamqp.com/vhost
PLATFORM_AMQP_EXCHANGE=miriam
PLATFORM_AMQP_QUEUE=miriam.inbound
PLATFORM_AMQP_ROUTING_KEY=message.inbound
PLATFORM_AMQP_ACTION_QUEUE=miriam.actions
PLATFORM_AMQP_ACTION_ROUTING_KEY=action.postback
PLATFORM_BRIDGE_HMAC_SECRET=your-hmac-secret-for-bridge-go-communication
PLATFORM_BRIDGE_BASE_URL=http://localhost:4000
# Platform address users text the link code to (e.g. the bridge's iMessage handle).
# Used to build the pre-filled "text this code" deep link in the link API response.
PLATFORM_BRIDGE_MESSAGING_ADDRESS=
# Base for app authorization deep links used when a fund-moving action (withdrawal/
# transfer) must be completed in-app with Face ID. Default "rail://".
PLATFORM_APP_DEEP_LINK_BASE_URL=rail://
PLATFORM_HANDSHAKE_TOKEN_TTL_SECONDS=900
# Chat-first onboarding: when true, an unknown iMessage sender can create a Tier 1
# account by texting Miriam (name → country → phone → SMS OTP → consent). When
# false, unlinked senders are asked to link from the app.
PLATFORM_ONBOARDING_ENABLED=false
# App download link Miriam shares during chat-first onboarding (where transactions
# are approved with Face ID). Defaults to the RAIL TestFlight build.
PLATFORM_APP_DOWNLOAD_URL=https://testflight.apple.com/join/3Q88URnF

# ============================================
# Transaction Enrichment Sidecar
# ============================================
# ML sidecar that classifies raw transaction descriptions into merchant names,
# categories, and plain-English descriptions for Miriam to read.
ENRICHMENT_ENABLED=false
ENRICHMENT_SERVICE_URL=http://enrichment:8090

# ============================================
# Miriam eval endpoint (terminal test harness) — NEVER enable in production
# ============================================
# Runs Miriam for an arbitrary user id, guarded only by EVAL_TOKEN. Used by the
# terminal eval TUI: cd cmd/spectrum-bridge && EVAL_TOKEN=... EVAL_USER_ID=... bun run eval
EVAL_ENABLED=false
EVAL_TOKEN=
