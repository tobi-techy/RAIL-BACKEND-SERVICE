#!/bin/bash
# Store all Rail secrets in AWS SSM Parameter Store.
# Usage:
#   1. cp store-secrets.sh.example store-secrets.sh
#   2. Fill in your actual values
#   3. chmod +x store-secrets.sh && ./store-secrets.sh
#
# NEVER commit the filled-in version to git!

ENV=staging   # staging | prod
REGION=us-east-1
PREFIX=/rail/$ENV

put() {
  aws ssm put-parameter --region $REGION --type SecureString \
    --name "$PREFIX/$1" --value "$2" --overwrite
}

# ── Core Auth ─────────────────────────────────────────────────────────────────
put JWT_SECRET     "CHANGE_ME_your_jwt_secret_here"
put ENCRYPTION_KEY          "CHANGE_ME_your_encryption_key_here"
put PASSWORD_EXPIRATION_DAYS '90'
put PASSWORD_HISTORY_COUNT '5'
put PASSWORD_MIN_LENGTH '8'
put PASSWORD_REQUIRE_LOWERCASE 'true'
put PASSWORD_REQUIRE_NUMBERS 'true'
put PASSWORD_REQUIRE_SPECIAL 'true'
put PASSWORD_REQUIRE_UPPERCASE 'true'

# ── Database ──────────────────────────────────────────────────────────────────
# Full connection string — RDS endpoint from: terraform output rds_endpoint
put DATABASE_URL     "CHANGE_ME_your_rds_endpoint_here"

# ── Alpaca ────────────────────────────────────────────────────────────────────
put ALPACA_API_KEY          "CHANGE_ME_your_alpaca_api_key_here"
put ALPACA_API_SECRET       "CHANGE_ME_your_alpaca_api_secret_here"
put ALPACA_FIRM_ACCOUNT_NO  "CHANGE_ME_your_alpaca_firm_account_no_here"
put ALPACA_BASE_URL         "https://paper-api.alpaca.markets"   # change to https://api.alpaca.markets for live
put ALPACA_DATA_BASE_URL    "https://data.alpaca.markets"
put ALPACA_WEBHOOK_SECRET   "CHANGE_ME_your_alpaca_webhook_secret_here"
put ALPACA_DATA_API_KEY     "CHANGE_ME_your_alpaca_data_api_key_here"
put ALPACA_DATA_API_SECRET  "CHANGE_ME_your_alpaca_data_api_secret_here"

# ── Bridge ────────────────────────────────────────────────────────────────────
put BRIDGE_API_KEY          "CHANGE_ME_bridge_api_key"
put BRIDGE_BASE_URL         "https://api.bridge.xyz"
put BRIDGE_ENVIRONMENT      "sandbox"   # change to production when ready
put BRIDGE_WEBHOOK_SECRET   "-----BEGIN PUBLIC KEY-----
MIIBIjANBgkqhkiG9w0BAQEFAAOCAQ8AMIIBCgKCAQEAvXphe41Vc+DqpbdHOoaP
mfh2J+Ew3wKDMgsXpXOAIFIcwUo6CCfV37IeJgEDMJynTbVwQurESss2bQdjDj2a
Fc4xgXWVZmJy5geAMQDxrqHYLNtQ8wElF7kntzLUL/rvmgqTmYGdea5YiiMW8/L/
tR25Rz0kassSoGg8LRiLZBn8UL4zfG0h1xAkj+BbFvzNdXKd2M68GbIrtTNkWkl1
1AaE+T3NlWHG7ElYWaXNbUY0PSwyncP0VWq2Lt8zmlozw+Stnf0xMEtAkJcmzBqN
avfnNQpF+KXXKM6PP1kUL4kbXrVf7Zp7ABHj8/feVqlkgk3Jrr3IqVJtK+ZSCjJM
ZQIDAQAB
-----END PUBLIC KEY-----
"
put BRIDGE_TIMEOUT "30"
put BRIDGE_MAX_RETRIES "3"
put BRIDGE_SUPPORTED_CHAINS "SOL"
put BRIDGE_RAIL_USDB_WALLET_ID "CHANGE_ME_bridge_wallet_id"
put BRIDGE_RAIL_CUSTOMER_ID   "CHANGE_ME_bridge_customer_id"
put CHAINRAILS_API_KEY "CHANGE_ME_chainrails_api_key"

# ── Email (Unosend) ───────────────────────────────────────────────────────────
put UNOSEND_API_KEY         "CHANGE_ME_unosend_api_key"
put EMAIL_FROM_EMAIL        "noreply@userail.money"
put EMAIL_FROM_NAME         "RAIL"

# ── Sumsub (KYC) ─────────────────────────────────────────────────────────────
put SUMSUB_APP_TOKEN  "CHANGE_ME_your_sumsub_app_token_here"
put SUMSUB_SECRET_KEY  "CHANGE_ME_your_sumsub_secret_key_here"
put SUMSUB_LEVEL_NAME "id-and-liveness"
put KYC_PROVIDER "sumsub"
put SOCIAL_AUTH_APPLE_CLIENT_ID "CHANGE_ME_your_apple_client_id_here"
put SOCIAL_AUTH_APPLE_TEAM_ID "CHANGE_ME_your_apple_team_id_here"
put SOCIAL_AUTH_APPLE_KEY_ID "CHANGE_ME_your_apple_key_id_here"
put SOCIAL_AUTH_APPLE_PRIVATE_KEY "CHANGE_ME_your_apple_private_key_base64_here"
put SOCIAL_AUTH_GOOGLE_CLIENT_ID "CHANGE_ME_your_google_client_id_here"

# ── Logo.dev (market logos) ───────────────────────────────────────────────────
put MARKET_LOGO_PROVIDER "logo_dev"
put MARKET_LOGO_BASE_URL "https://img.logo.dev"
put LOGO_DEV_PUBLISHABLE_KEY "CHANGE_ME_your_logo_dev_key_here"
put LOGO_DEV_SIZE "128"
put LOGO_DEV_FORMAT "png"
put LOGO_DEV_THEME "auto"

# ── Sentry (optional but recommended) ────────────────────────────────────────
put SENTRY_DSN  "CHANGE_ME_your_sentry_dsn_here"
put RATE_LIMIT_ENABLED "true"
put RATE_LIMIT_FAIL_OPEN "true"
put RATE_LIMIT_GLOBAL_LIMIT "10000"
put RATE_LIMIT_GLOBAL_WINDOW "60"
put RATE_LIMIT_IP_LIMIT "500"
put RATE_LIMIT_IP_WINDOW "60"
put RATE_LIMIT_RESPONSE_HEADERS "true"
put RATE_LIMIT_USER_LIMIT "200"
put RATE_LIMIT_USER_WINDOW "60"
put REDIS_CLUSTER_MODE "false"
put REDIS_DB "0"
put REDIS_HOST "CHANGE_ME_your_redis_host_here"
put REDIS_PASSWORD "CHANGE_ME_your_redis_password_here"
put REDIS_PORT "6379"
put REDIS_TLS "true"
put SMTP_USE_TLS "false"
put WEBAUTHN_RP_ID "CHANGE_ME_your_webauthn_rp_id_here"
put WEBAUTHN_RP_ORIGINS "CHANGE_ME_your_webauthn_rp_origins_here"
put WEBAUTHN_RP_DISPLAY_NAME "RAIL"

# ── SNS Push Notifications ────────────────────────────────────────────────────
put SNS_PUSH_REGION          "us-east-1"
put SNS_PUSH_IOS_PLATFORM_ARN     "CHANGE_ME_arn:aws:sns:us-east-1:ACCOUNT_ID:app/APNS/RailIOS"
put SNS_PUSH_ANDROID_PLATFORM_ARN "CHANGE_ME_arn:aws:sns:us-east-1:ACCOUNT_ID:app/GCM/RailAndroid"

# ── Circle Programmable Wallets ───────────────────────────────────────────────
put CIRCLE_API_KEY              "CHANGE_ME_your_circle_api_key_here"
put CIRCLE_ENTITY_SECRET        "CHANGE_ME_your_64_char_hex_entity_secret_here"
put CIRCLE_ENVIRONMENT          "sandbox"
put CIRCLE_DEFAULT_WALLET_SET_ID "CHANGE_ME_your_wallet_set_id_here"
put CIRCLE_WEBHOOK_SECRET       "CHANGE_ME_your_circle_webhook_secret_here"

echo "Done. Verify with: aws ssm get-parameters-by-path --path $PREFIX --region $REGION --with-decryption"
