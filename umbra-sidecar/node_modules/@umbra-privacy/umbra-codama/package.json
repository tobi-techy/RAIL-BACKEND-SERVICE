{
  "name": "@umbra-privacy/umbra-codama",
  "version": "2.0.2",
  "description": "Generated Codama clients for the Umbra protocol",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "dependencies": {
    "@solana-program/system": "^0.11.0",
    "@solana-program/token-2022": "^0.9.0",
    "@solana/kit": "^6.0.1",
    "@solana/sysvars": "^6.0.1"
  },
  "devDependencies": {
    "codama": "^1.5.0",
    "@codama/nodes-from-anchor": "^1.3.8",
    "@codama/renderers-js": "^1.7.0",
    "@codama/renderers-rust": "^1.2.9",
    "tsup": "^8.3.5",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "keywords": [
    "umbra",
    "solana",
    "codama",
    "privacy",
    "anchor"
  ],
  "scripts": {
    "build": "tsup",
    "build:watch": "tsup --watch",
    "clean": "rm -rf dist node_modules/.cache",
    "typecheck": "tsc --noEmit"
  }
}