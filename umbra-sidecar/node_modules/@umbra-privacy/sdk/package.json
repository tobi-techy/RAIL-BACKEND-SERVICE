{
  "name": "@umbra-privacy/sdk",
  "version": "4.0.0",
  "description": "A comprehensive TypeScript SDK for Umbra Privacy",
  "author": "",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      "crypto": [
        "./dist/crypto/index.d.ts"
      ],
      "pda": [
        "./dist/common/pda/index.d.ts"
      ],
      "solana": [
        "./dist/solana/index.d.ts"
      ],
      "math": [
        "./dist/math/index.d.ts"
      ],
      "types": [
        "./dist/types/index.d.ts"
      ],
      "interfaces": [
        "./dist/interfaces/index.d.ts"
      ],
      "utils": [
        "./dist/utils/index.d.ts"
      ],
      "constants": [
        "./dist/constants/index.d.ts"
      ],
      "errors": [
        "./dist/errors/index.d.ts"
      ]
    }
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./types": {
      "import": {
        "types": "./dist/types/index.d.ts",
        "default": "./dist/types/index.js"
      },
      "require": {
        "types": "./dist/types/index.d.cts",
        "default": "./dist/types/index.cjs"
      }
    },
    "./interfaces": {
      "import": {
        "types": "./dist/interfaces/index.d.ts",
        "default": "./dist/interfaces/index.js"
      },
      "require": {
        "types": "./dist/interfaces/index.d.cts",
        "default": "./dist/interfaces/index.cjs"
      }
    },
    "./utils": {
      "import": {
        "types": "./dist/utils/index.d.ts",
        "default": "./dist/utils/index.js"
      },
      "require": {
        "types": "./dist/utils/index.d.cts",
        "default": "./dist/utils/index.cjs"
      }
    },
    "./constants": {
      "import": {
        "types": "./dist/constants/index.d.ts",
        "default": "./dist/constants/index.js"
      },
      "require": {
        "types": "./dist/constants/index.d.cts",
        "default": "./dist/constants/index.cjs"
      }
    },
    "./crypto": {
      "import": {
        "types": "./dist/crypto/index.d.ts",
        "default": "./dist/crypto/index.js"
      },
      "require": {
        "types": "./dist/crypto/index.d.cts",
        "default": "./dist/crypto/index.cjs"
      }
    },
    "./pda": {
      "import": {
        "types": "./dist/common/pda/index.d.ts",
        "default": "./dist/common/pda/index.js"
      },
      "require": {
        "types": "./dist/common/pda/index.d.cts",
        "default": "./dist/common/pda/index.cjs"
      }
    },
    "./solana": {
      "import": {
        "types": "./dist/solana/index.d.ts",
        "default": "./dist/solana/index.js"
      },
      "require": {
        "types": "./dist/solana/index.d.cts",
        "default": "./dist/solana/index.cjs"
      }
    },
    "./math": {
      "import": {
        "types": "./dist/math/index.d.ts",
        "default": "./dist/math/index.js"
      },
      "require": {
        "types": "./dist/math/index.d.cts",
        "default": "./dist/math/index.cjs"
      }
    },
    "./errors": {
      "import": {
        "types": "./dist/errors/index.d.ts",
        "default": "./dist/errors/index.js"
      },
      "require": {
        "types": "./dist/errors/index.d.cts",
        "default": "./dist/errors/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "dependencies": {
    "@noble/ciphers": "^2.1.1",
    "@noble/curves": "^2.0.1",
    "@noble/hashes": "^2.0.1",
    "@solana/kit": "^6.0.1",
    "@solana/wallet-standard-features": "^1.3.0",
    "@wallet-standard/core": "^1.1.0",
    "@umbra-privacy/arcium-codama": "2.0.1",
    "@umbra-privacy/indexer-read-service-client": "2.0.1",
    "@umbra-privacy/umbra-codama": "2.0.2"
  },
  "devDependencies": {
    "@arcium-hq/client": "0.8.3",
    "@types/node": "^22.10.5",
    "@typescript-eslint/eslint-plugin": "^8.20.0",
    "@typescript-eslint/parser": "^8.20.0",
    "@vitest/coverage-v8": "^2.1.8",
    "eslint": "^9.28.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-unicorn": "^56.0.1",
    "tsup": "^8.3.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.55.0",
    "vitest": "^2.1.8"
  },
  "peerDependencies": {
    "@wallet-standard/core": ">=1.0.0"
  },
  "peerDependenciesMeta": {
    "@wallet-standard/core": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "keywords": [
    "umbra",
    "privacy",
    "sdk",
    "typescript",
    "solana",
    "cryptography"
  ],
  "scripts": {
    "build": "tsup",
    "build:watch": "tsup --watch",
    "dev": "tsup --watch",
    "clean": "rm -rf dist node_modules/.cache",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  }
}